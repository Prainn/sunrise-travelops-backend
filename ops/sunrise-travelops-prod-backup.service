[Unit]
Description=Sunrise TravelOps production database and configuration backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=1h
ExecStart=/usr/local/sbin/sunrise-travelops-backup prod
