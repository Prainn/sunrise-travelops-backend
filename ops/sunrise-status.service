[Unit]
Description=Collect Sunrise service and deployment status
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/sunrise-status.env
ExecStart=/usr/bin/python3 /usr/local/sbin/sunrise-collect-status
TimeoutStartSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/sunrise-travelops-dev/status /opt/sunrise-travelops-dev/status-state
