# Install as /etc/sunrise-status.env, root:root 0600. Never commit populated secrets.
# Fine-grained GitHub token: Actions read on ONLY the two Sunrise repositories.
STATUS_GITHUB_TOKEN=
# Alibaba Mail SMTP over TLS. Receiver is not the SMTP sender account.
STATUS_SMTP_HOST=smtp.qiye.aliyun.com
STATUS_SMTP_PORT=465
STATUS_SMTP_USER=
STATUS_SMTP_PASSWORD=
STATUS_SMTP_FROM=
STATUS_SMTP_TO=
