[Unit]
Description=Sunrise TravelOps development database and configuration backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=1h
ExecStart=/opt/sunrise-travelops-dev/backup.sh
